+        if ( script != HB_SCRIPT_LATIN && script != HB_SCRIPT_GREEK
+                && script != HB_SCRIPT_CYRILLIC && script != HB_SCRIPT_INVALID ) {
+            return false;
+        }
+        hb_language_t lang = lang_cfg ? lang_cfg->getHBLanguage() : HB_LANGUAGE_INVALID;
+        if ( lang == HB_LANGUAGE_INVALID )
+            lang = hb_language_get_default();
+        LVShapingCache * cache = getShapingCache();
+        lUInt32 owner = 0;
+        for ( int i=0; i < _shaping_nb_langs; i++ ) {
+            if ( _shaping_langs[i] == lang ) {
+                owner = _shaping_owners[i];
+                break;
+            }
+        }
+        if ( !owner ) { // (past SHAPING_FONT_LANGS languages, text is shaped as a whole)
+            if ( _shaping_nb_langs >= SHAPING_FONT_LANGS )
+                return false;
+            owner = cache->newOwner();
+            if ( !owner )
+                return false;
+            _shaping_langs[_shaping_nb_langs] = lang;
+            _shaping_owners[_shaping_nb_langs] = owner;
+            _shaping_nb_langs++;
+        }
+        // Buffer flags: the ones set for shaping as a whole, or the ones left from the
+        // previous shaping (hb_buffer_clear_contents() does not reset them)
+        unsigned int run_flags;
+        if ( hints ) {
+            run_flags = HB_BUFFER_FLAG_DEFAULT;
+            if ( hints & LFNT_HINT_BEGINS_PARAGRAPH )
+                run_flags |= HB_BUFFER_FLAG_BOT;
+            if ( hints & LFNT_HINT_ENDS_PARAGRAPH )
+                run_flags |= HB_BUFFER_FLAG_EOT;
+        }
+        else {
+            run_flags = hb_buffer_get_flags(_hb_buffer);
+        }
+        if ( run_flags & ~(unsigned int)(HB_BUFFER_FLAG_BOT|HB_BUFFER_FLAG_EOT) )
+            return false;
+
+        // Cut the text into pieces, each ending after a space (but the last one),
+        // and look them up in the cache (there is nothing to undo if we give up because
+        // of a char not allowed: entries found may just have been moved to the current
+        // generation)
+        cache->prepare(); // entries found stay valid until we're done
+        _shapingPieces.reserve(len);
+        LVShapingPiece * pieces = _shapingPieces.get();
+        int nb_pieces = 0;
+        int nb_missing = 0;
+        int nb_glyphs = 0;
+        int script_index = script == HB_SCRIPT_LATIN ? 1 : script == HB_SCRIPT_GREEK ? 2 : script == HB_SCRIPT_CYRILLIC ? 3 : 0;
+        LVShapingCacheKey key;
+        key.owner = owner;
+        lUInt32 seed = 2166136261u ^ (owner * 0x9E3779B1u) ^ (script_index * 0x85EBCA77u);
+        lUInt32 hash = seed;
+        int start = 0;
+        for ( int i=0; i < len; i++ ) {
+            lChar32 c = text[i];
+            if ( c >= SHAPING_CHARS_LIMIT || !(chars[c >> 5] & (1U << (c & 31))) )
+                return false;
+            hash = (hash ^ (lUInt32)c) * 16777619u;
+            if ( i+1 < len && !( c == ' ' && text[i+1] != ' ' && isShapingSafeAfterSpace(text[i+1]) ) )
+                continue;
+            LVShapingPiece * piece = pieces + nb_pieces++;
+            piece->start = start;
+            piece->end = i+1;
+            piece->buffer_flags = (start == 0 ? run_flags & HB_BUFFER_FLAG_BOT : 0)
+                                | (i+1 == len ? run_flags & HB_BUFFER_FLAG_EOT : 0);
+            piece->hash = shapingHashFinish(hash ^ piece->buffer_flags);
+            piece->entry = NULL;
+            if ( i+1 - start <= SHAPING_CACHE_MAX_PIECE ) {
+                key.hash = piece->hash;
+                key.props = script_index | (piece->buffer_flags << 2) | kind;
+                key.text = text + start;
+                key.text_len = i+1 - start;
+                piece->entry = cache->find(key);
+            }
+            if ( piece->entry ) {
+                nb_glyphs += piece->entry->glyph_count;
+            }
+            else {
+                nb_missing++;
+            }
+            hash = seed;
+            start = i+1;
+        }
+
+        // Shape all the pieces not found at once: as nothing is seen across the spaces
+        // they end with, each gets the glyphs it would get if shaped alone, or as part
+        // of the whole text.
+        hb_glyph_info_t * batch_info = NULL;
+        hb_glyph_position_t * batch_pos = NULL;
+        if ( nb_missing ) {
+            if ( !_shapingBatchBuffer ) {
+                hb_buffer_t * buffer = hb_buffer_create();
+                if ( !hb_buffer_allocation_successful(buffer) ) { // (the empty buffer)
+                    hb_buffer_destroy(buffer);
+                    return false;
+                }
+                _shapingBatchBuffer = buffer;
+            }
+            hb_buffer_t * batch = _shapingBatchBuffer;
+            hb_buffer_clear_contents(batch);
+            int first = -1;
+            int last = -1;
+            for ( int p=0; p < nb_pieces; p++ ) {
+                if ( pieces[p].entry )
+                    continue;
+                if ( first < 0 )
+                    first = p;
+                last = p;
+                for ( int i=pieces[p].start; i < pieces[p].end; i++ )
+                    hb_buffer_add(batch, (hb_codepoint_t)text[i], i);
+            }
+            hb_buffer_set_content_type(batch, HB_BUFFER_CONTENT_TYPE_UNICODE);
+            int batch_flags = HB_BUFFER_FLAG_DEFAULT;
+            if ( pieces[first].start == 0 )
+                batch_flags |= run_flags & HB_BUFFER_FLAG_BOT;
+            if ( pieces[last].end == len )
+                batch_flags |= run_flags & HB_BUFFER_FLAG_EOT;
+            hb_buffer_set_flags(batch, (hb_buffer_flags_t)batch_flags); // NOLINT(clang-analyzer-optin.core.EnumCastOutOfRange)
+            hb_buffer_set_direction(batch, HB_DIRECTION_LTR);
+            hb_buffer_set_script(batch, script);
+            hb_buffer_set_language(batch, lang);
+            hb_buffer_guess_segment_properties(batch); // (nothing left to guess)
+            hb_shape(getShapingHBFont(), batch, _hb_features.ptr(), (unsigned int)_hb_features.length());
+            unsigned int batch_count = hb_buffer_get_length(batch);
+            // Nothing to keep if an allocation failed, or HarfBuzz' budget of operations for
+            // this buffer was exceeded (the whole text may or may not exceed its own)
+            if ( !hb_buffer_allocation_successful(batch) || batch_count == 0 )
+                return false;
+            batch_info = hb_buffer_get_glyph_infos(batch, NULL);
+            batch_pos = hb_buffer_get_glyph_positions(batch, NULL);
+            // Glyphs come in text order: give each piece its own
+            unsigned int g = 0;
+            for ( int p=0; p < nb_pieces; p++ ) {
+                if ( pieces[p].entry )
+                    continue;
+                pieces[p].batch_start = g;
+                while ( g < batch_count && batch_info[g].cluster >= (unsigned int)pieces[p].start
+                                        && batch_info[g].cluster < (unsigned int)pieces[p].end )
+                    g++;
+                pieces[p].batch_end = g;
+                if ( g == (unsigned int)pieces[p].batch_start ) // no glyph: not expected
+                    return false;
+            }
+            if ( g != batch_count ) // not expected
+                return false;
+            nb_glyphs += batch_count;
+            lInt16 * measures = NULL;
+            if ( kind == SHAPING_MEASURES ) {
+                // (measures of all the pieces not found, at their text index)
+                _shapingMeasures.reserve(len);
+                measures = _shapingMeasures.get();
+                for ( int p=0; p < nb_pieces; p++ ) {
+                    if ( pieces[p].entry )
+                        continue;
+                    if ( !LVShapingCache::computeMeasures(batch_info + pieces[p].batch_start, batch_pos + pieces[p].batch_start,
+                                pieces[p].batch_end - pieces[p].batch_start, pieces[p].start,
+                                pieces[p].end - pieces[p].start, _synth_weight_strength, measures + pieces[p].start) )
+                        return false;
+                }
+            }
+            for ( int p=0; p < nb_pieces; p++ ) {
+                if ( pieces[p].entry || pieces[p].end - pieces[p].start > SHAPING_CACHE_MAX_PIECE )
+                    continue;
+                key.hash = pieces[p].hash;
+                key.props = script_index | (pieces[p].buffer_flags << 2) | kind;
+                key.text = text + pieces[p].start;
+                key.text_len = pieces[p].end - pieces[p].start;
+                if ( kind == SHAPING_MEASURES )
+                    pieces[p].entry = cache->addMeasures(key, measures + pieces[p].start);
+                else
+                    pieces[p].entry = cache->addGlyphs(key, batch_info + pieces[p].batch_start, batch_pos + pieces[p].batch_start,
+                                pieces[p].batch_end - pieces[p].batch_start, pieces[p].start);
+            }
+        }
+        _shapingNbPieces = nb_pieces;
+        _shapingNbGlyphs = nb_glyphs;
+        // Leave the buffer flags as shaping as a whole would
+        hb_buffer_set_flags(_hb_buffer, (hb_buffer_flags_t)run_flags); // NOLINT(clang-analyzer-optin.core.EnumCastOutOfRange)
+        return true;
+    }
