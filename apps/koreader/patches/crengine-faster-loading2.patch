+#if CR_BACKGROUND_UNZIP == 1
+/// Computes a stream's crc32 code as LVStream::getcrc32() does, reading it with ReadAt()
+/// in another thread
+class LVStreamCrc32Thread : public LVStreamCrc32Task
+{
+    LVStreamRef _stream;   // keeps the stream alive (taken and dropped by the thread that made this)
+    LVStream * _readStream; // what the other thread reads, with ReadAt() only
+    lvsize_t _size;
+    lUInt32 _crc;
+    bool _ok;
+    pthread_t _thread;
+    bool _joined;
+    void run()
+    {
+        lUInt8 * buf = (lUInt8 *)malloc( CRC_BIG_BUF_SIZE );
+        if ( !buf )
+            return;
+        lUInt32 crc = 0;
+        bool ok = true;
+        for ( lvpos_t pos = 0; pos < _size; pos += CRC_BIG_BUF_SIZE ) {
+            lvsize_t sz = _size - pos;
+            if ( sz > CRC_BIG_BUF_SIZE )
+                sz = CRC_BIG_BUF_SIZE;
+            lvsize_t bytesRead = 0;
+            if ( _readStream->ReadAt( pos, buf, sz, &bytesRead )!=LVERR_OK || bytesRead!=sz ) {
+                ok = false;
+                break;
+            }
+            crc = lStr_crc32( crc, buf, sz );
+        }
+        free( buf );
+        _crc = crc;
+        _ok = ok;
+    }
+    static void * threadMain( void * arg )
+    {
+        ((LVStreamCrc32Thread *)arg)->run();
+        return NULL;
+    }
+public:
+    LVStreamCrc32Thread( LVStreamRef stream ) : _stream(stream), _readStream(stream.get()), _size(stream->GetSize()), _crc(0), _ok(false), _joined(true) { }
+    bool start()
+    {
+        _joined = pthread_create( &_thread, NULL, threadMain, this ) != 0;
+        return !_joined;
+    }
+    virtual bool wait( lUInt32 & crc )
+    {
+        if ( !_joined ) {
+            pthread_join( _thread, NULL );
+            _joined = true;
+        }
+        crc = _crc;
+        return _ok;
+    }
+    virtual ~LVStreamCrc32Thread()
+    {
+        lUInt32 crc;
+        wait( crc );
+    }
+};
+#endif
+
+LVStreamCrc32Task * LVStartStreamCrc32( LVStreamRef stream )
+{
+#if CR_BACKGROUND_UNZIP == 1
+    if ( stream.isNull() )
+        return NULL;
+    lvopen_mode_t mode = stream->GetMode();
+    if ( mode != LVOM_READ && mode != LVOM_APPEND ) // (what getcrc32() requires)
+        return NULL;
+    // Worth it for files only large enough to take time, readable from another thread
+    lUInt8 probe[4];
+    lvsize_t probed = 0;
+    if ( stream->GetSize() <= CRC_BIG_BUF_SIZE || stream->ReadAt( 0, probe, 4, &probed )!=LVERR_OK || probed!=4 )
+        return NULL;
+    LVStreamCrc32Thread * task = new LVStreamCrc32Thread( stream );
+    if ( !task->start() ) {
+        delete task;
+        return NULL;
+    }
+    return task;
+#else
+    CR_UNUSED(stream);
+    return NULL;
+#endif
 }
 
