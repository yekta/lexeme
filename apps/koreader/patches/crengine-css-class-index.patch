+
+static int compareCssIndexEntries( const void * a, const void * b )
+{
+    const LVStyleSheet::IndexEntry * x = (const LVStyleSheet::IndexEntry *)a;
+    const LVStyleSheet::IndexEntry * y = (const LVStyleSheet::IndexEntry *)b;
+    if ( x->hash != y->hash )
+        return x->hash < y->hash ? -1 : 1;
+    return x->pos - y->pos;
+}
+
+void LVStyleSheet::buildIndex() const
+{
+    _index.clear();
+    _index_ranges.clear();
+    for ( int i=0; i<_selectors.length(); i++ ) {
+        int classless = _index.length();
+        int pos = 0;
+        for ( LVCssSelector * p = _selectors[i]; p; p = p->getNext(), pos++ ) {
+            lUInt32 hash;
+            if ( !p->getRequiredClassHash(hash) ) {
+                IndexEntry entry = { 0, pos, p };
+                _index.add( entry );
+            }
+        }
+        int classed = _index.length();
+        pos = 0;
+        for ( LVCssSelector * p = _selectors[i]; p; p = p->getNext(), pos++ ) {
+            lUInt32 hash;
+            if ( p->getRequiredClassHash(hash) ) {
+                IndexEntry entry = { hash, pos, p };
+                _index.add( entry );
+            }
+        }
+        int end = _index.length();
+        if ( end - classed > 1 )
+            qsort( _index.ptr() + classed, end - classed, sizeof(IndexEntry), compareCssIndexEntries );
+        _index_ranges.add( classless );
+        _index_ranges.add( classed );
+        _index_ranges.add( end );
+    }
+    _index_valid = true;
+}
