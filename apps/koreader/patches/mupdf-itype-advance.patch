+int
+fz_ft_get_unscaled_advance(void *face_, unsigned int gid, int load_flags, long *adv)
+{
+	FT_Face face = face_;
+	FT_Fixed value = 0;
+	FT_Error fterr = FT_Get_Advance(face, gid, load_flags, &value);
+	if (!fterr && face->driver == (FT_Driver)FT_Get_Module(face->glyph->library, "itype drv"))
+		value /= 64;
+	*adv = value;
+	return fterr;
+}
