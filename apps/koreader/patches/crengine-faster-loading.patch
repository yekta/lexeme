+/// Prepares the streams of ZIP entries that are going to be opened one after the other: this
+/// thread reads the compressed data of the entries following the one asked for, and another
+/// thread decompresses them while this one works on the previous ones. The stream given is a
+/// memory stream with the data, size and name LVZipArc::OpenStream()'s stream would give.
+/// Anything unusual (an unknown method, data not decompressing to the size the archive's
+/// directory says, huge entries) is left to OpenStream().
+class LVZipPrefetcher : public LVStreamPrefetcher
+{
+    enum { SKIPPED, NOT_READ, READ, INFLATING, DONE, FAILED, TAKEN };
+    struct Entry {
+        lString32 name;     // the stream's name
+        lvpos_t pos;        // position of its local header
+        lvsize_t packSize;
+        lvsize_t unpSize;
+        int method;
+        lUInt8 * packed;    // compressed data, read by this thread (with the local header)
+        lvsize_t packedOffset; // where the data starts in it
+        lUInt8 * data;      // decompressed by the other one
+        lvsize_t held;      // memory this entry counts for in _heldBytes
+        int state;
+        Entry() : pos(0), packSize(0), unpSize(0), method(0), packed(NULL), packedOffset(0), data(NULL), held(0), state(SKIPPED) { }
+    };
+    // Entries prepared ahead are limited in number and in memory (compressed and
+    // decompressed data both count): enough to keep the other thread busy.
+    static const int MAX_AHEAD_ENTRIES = 16;
+    static const lvsize_t MAX_AHEAD_BYTES = 0x100000;
+    // Larger entries are left to OpenStream(), which doesn't need them whole in memory
+    static const lvsize_t MAX_ENTRY_SIZE = 0x100000;
+    // Room for the name and extra field of a local header, guessed for reading it with
+    // the data
+    static const lvsize_t READ_NAME_SLACK = 0x100;
+
+    LVStreamRef _stream;    // the archive
+    Entry * _entries;
+    int _count;
+    int _nextRead;          // next entry to read (this thread)
+    int _nextInflate;       // next entry to decompress (the other thread)
+    lvsize_t _heldBytes;
+    bool _stop;
+    bool _threadWaiting;    // the other thread waits for entries to be read
+    bool _takerWaiting;     // this thread waits for an entry to be decompressed
+    pthread_t _thread;
+    pthread_mutex_t _mutex;
+    pthread_cond_t _cond;
+
+    /// reads an entry's compressed data, checking what LVZipDecodeStream::Create() checks
+    bool readEntry( Entry & e )
+    {
+        ZipLocalFileHdr hdr;
+        unsigned hdr_size = 0x1E; //sizeof(hdr);
+        // Read the local header and the data that follows it at once, guessing the size
+        // of the name and extra field in between (reading the rest if more): one read
+        // rather than two, for the many small entries of some books.
+        lvsize_t fileSize = _stream->GetSize();
+        if ( e.pos >= fileSize )
+            return false;
+        lvsize_t span = hdr_size + READ_NAME_SLACK + e.packSize;
+        if ( span > fileSize - e.pos )
+            span = fileSize - e.pos;
+        // Both buffers are allocated here rather than in the other thread, which would
+        // have them come from (and go back to) a memory arena of its own.
+        e.packed = (lUInt8 *)malloc( span );
+        if ( !e.packed )
+            return false;
+        lvsize_t ReadSize = 0;
+        if ( _stream->Seek( e.pos, LVSEEK_SET, NULL )!=LVERR_OK
+                || _stream->Read( e.packed, span, &ReadSize )!=LVERR_OK || ReadSize < hdr_size ) {
+            free( e.packed );
+            e.packed = NULL;
+            return false;
+        }
+        memcpy( &hdr, e.packed, hdr_size );
+        hdr.byteOrderConv();
+        lvsize_t dataOffset = hdr_size + hdr.getNameLen() + hdr.getAddLen();
+        lvpos_t pos = e.pos + dataOffset;
+        bool ok = (lvpos_t)(pos + e.packSize) <= (lvpos_t)fileSize;
+        e.method = hdr.getMethod();
+        if ( e.method == 0 ) {
+            if ( e.packSize != e.unpSize )
+                ok = false;
+        } else if ( e.method != 8 ) {
+            ok = false;
+        }
+        if ( ok && dataOffset + e.packSize > ReadSize ) {
+            // More than guessed: read the rest
+            lUInt8 * buf = (lUInt8 *)realloc( e.packed, dataOffset + e.packSize );
+            if ( !buf ) {
+                ok = false;
+            } else {
+                e.packed = buf;
+                lvsize_t rest = dataOffset + e.packSize - ReadSize;
+                lvsize_t n = 0;
+                ok = _stream->Seek( e.pos + ReadSize, LVSEEK_SET, NULL )==LVERR_OK
+                        && _stream->Read( e.packed + ReadSize, rest, &n )==LVERR_OK && n==rest;
+            }
+        }
+        if ( !ok ) {
+            free( e.packed );
+            e.packed = NULL;
+            return false;
+        }
+        e.packedOffset = dataOffset;
+        if ( e.method == 0 ) {
+            memmove( e.packed, e.packed + dataOffset, e.packSize );
+            e.packedOffset = 0;
+            e.data = e.packed;
+            e.packed = NULL;
+        } else {
+            // (One byte more than expected, to notice data longer than said.)
+            e.data = (lUInt8 *)malloc( e.unpSize + 1 );
+            if ( !e.data ) {
+                free( e.packed );
+                e.packed = NULL;
+                return false;
+            }
+        }
+        return true;
+    }
+    /// decompresses an entry into its data buffer, true if it is exactly what the
+    /// archive's directory says (zs: an inflate state for raw deflate data)
+    static bool inflateEntry( Entry & e, z_stream * zs )
+    {
+        if ( e.method == 0 )
+            return true;
+        bool ok = false;
+        if ( inflateReset( zs ) == Z_OK ) {
+            zs->next_in = e.packed + e.packedOffset;
+            zs->avail_in = (uInt)e.packSize;
+            zs->next_out = e.data;
+            zs->avail_out = (uInt)(e.unpSize + 1);
+            int res = inflate( zs, Z_FINISH );
+            ok = res == Z_STREAM_END && zs->total_out == e.unpSize;
+        }
+        return ok;
+    }
+    /// reads entries ahead of index (and index itself) as far as the limits allow, once
+    /// those read ahead are down to half the limit: waking the other thread up for each
+    /// entry would cost more than decompressing the many small ones of some books
+    void readAhead( int index )
+    {
+        if ( _nextRead > index + MAX_AHEAD_ENTRIES / 2 )
+            return;
+        int first = _nextRead;
+        while ( _nextRead < _count && ( _nextRead <= index ||
+                ( _nextRead < index + MAX_AHEAD_ENTRIES && _heldBytes < MAX_AHEAD_BYTES ) ) ) {
+            Entry & e = _entries[_nextRead++];
+            if ( e.state != NOT_READ )
+                continue;
+            if ( readEntry( e ) ) {
+                e.held = e.packSize + e.unpSize;
+                _heldBytes += e.held;
+            }
+        }
+        pthread_mutex_lock( &_mutex );
+        for ( int i = first; i < _nextRead; i++ ) {
+            Entry & e = _entries[i];
+            if ( e.state == NOT_READ )
+                e.state = e.held ? READ : FAILED;
+        }
+        if ( _threadWaiting )
+            pthread_cond_broadcast( &_cond );
+        pthread_mutex_unlock( &_mutex );
+    }
+    void run()
+    {
+        z_stream zs;
+        memset( &zs, 0, sizeof(zs) );
+        bool zsOk = inflateInit2( &zs, -15 ) == Z_OK;
+        pthread_mutex_lock( &_mutex );
+        while ( !_stop && _nextInflate < _count ) {
+            Entry & e = _entries[_nextInflate];
+            if ( e.state == NOT_READ ) {
+                _threadWaiting = true;
+                pthread_cond_wait( &_cond, &_mutex );
+                _threadWaiting = false;
+                continue;
+            }
+            if ( e.state == READ ) {
+                e.state = INFLATING;
+                pthread_mutex_unlock( &_mutex );
+                bool ok = zsOk && inflateEntry( e, &zs );
+                pthread_mutex_lock( &_mutex );
+                e.state = ok ? DONE : FAILED;
+                if ( _takerWaiting )
+                    pthread_cond_broadcast( &_cond );
+            }
+            _nextInflate++;
+        }
+        pthread_mutex_unlock( &_mutex );
+        if ( zsOk )
+            inflateEnd( &zs );
+    }
+    static void * threadMain( void * arg )
+    {
+        ((LVZipPrefetcher *)arg)->run();
+        return NULL;
+    }
+    LVZipPrefetcher( LVStreamRef stream, int count )
+        : _stream(stream), _count(count), _nextRead(0), _nextInflate(0), _heldBytes(0)
+        , _stop(false)
+        , _threadWaiting(false), _takerWaiting(false)
+    {
+        _entries = new Entry[count];
+        pthread_mutex_init( &_mutex, NULL );
+        pthread_cond_init( &_cond, NULL );
+    }
+public:
+    static LVZipPrefetcher * create( LVContainer * arc, LVStreamRef stream, const lString32Collection & names )
+    {
+        int count = names.length();
+        if ( count <= 0 || stream.isNull() )
+            return NULL;
+        LVZipPrefetcher * res = new LVZipPrefetcher( stream, count );
+        for ( int i = 0; i < count; i++ ) {
+            const lChar32 * fname = names[i].c_str();
+            if ( !fname[0] )
+                continue;
+            if ( fname[0]=='/' )
+                fname++;
+            LVCommonContainerItemInfo * item = (LVCommonContainerItemInfo*)arc->GetObjectInfo(lString32(fname));
+            if ( !item || item->GetSize() == 0 || item->GetSize() > MAX_ENTRY_SIZE || item->GetSrcSize() > MAX_ENTRY_SIZE )
+                continue;
+            Entry & e = res->_entries[i];
+            e.name = item->GetName();
+            e.pos = item->GetSrcPos();
+            e.packSize = item->GetSrcSize();
+            e.unpSize = item->GetSize();
+            e.state = NOT_READ;
+        }
+        if ( pthread_create( &res->_thread, NULL, threadMain, res ) != 0 ) {
+            delete[] res->_entries; // (no thread to stop)
+            res->_entries = NULL;
+            res->_count = 0;
+            delete res;
+            return NULL;
+        }
+        return res;
+    }
+    virtual ~LVZipPrefetcher()
+    {
+        if ( _entries ) {
+            pthread_mutex_lock( &_mutex );
+            _stop = true;
+            pthread_cond_broadcast( &_cond );
+            pthread_mutex_unlock( &_mutex );
+            pthread_join( _thread, NULL );
+            for ( int i = 0; i < _count; i++ ) {
+                free( _entries[i].packed );
+                free( _entries[i].data );
+            }
+            delete[] _entries;
+        }
+        pthread_cond_destroy( &_cond );
+        pthread_mutex_destroy( &_mutex );
+    }
