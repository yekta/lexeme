+lString32 Utf8ToUnicodeUpToZero( const char * s, int sz ) {
+    // The same as Utf8ToUnicode( const char * s ) does on a copy of these sz bytes (which
+    // stops at its first zero byte): it counts the chars as Utf8CharCount( const lChar8 * str ),
+    // then decodes them as DecodeUtf8(). Both are done here in a single pass, with s[sz] taken
+    // as that copy's terminating zero.
+    if ( !s || sz <= 0 || !s[0] )
+        return lString32::empty_str;
+    lString32 dst;
+    dst.reserve(sz); // (there are at most sz chars)
+    lChar32 * p = dst.pchunk->buf32;
+    const lUInt8 * str = (const lUInt8 *)s;
+    const lUInt8 * endp = str + sz;
+    int len = 0;
+    lUInt8 ch;
+    while ( str < endp && (ch=*str) ) {
+        if ( (ch & 0x80) == 0 ) {
+            p[len] = ch;
+            str += 1;
+        } else if ( (ch & 0xE0) == 0xC0 ) {
+            if ( str+1 >= endp || !str[1] )
+                break;
+            p[len] = ((ch & 0x1F) << 6) | (str[1] & 0x3F);
+            str += 2;
+        } else if ( (ch & 0xF0) == 0xE0 ) {
+            if ( str+1 >= endp || !str[1] || str+2 >= endp || !str[2] )
+                break;
+            p[len] = ((ch & 0x0F) << 12) | ((lChar32)(str[1] & 0x3F) << 6) | (str[2] & 0x3F);
+            str += 3;
+        } else if ( (ch & 0xF8) == 0xF0 ) {
+            if ( str+1 >= endp || !str[1] || str+2 >= endp || !str[2] || str+3 >= endp || !str[3] )
+                break;
+            p[len] = ((lChar32)(ch & 0x07) << 18) | ((lChar32)(str[1] & 0x3F) << 12)
+                        | ((lChar32)(str[2] & 0x3F) << 6) | (str[3] & 0x3F);
+            str += 4;
+        } else {
+            // invalid first byte in UTF-8 sequence: passed with mask 0x7F, as DecodeUtf8() does
+            p[len] = ch & 0x7F;
+            str += 1;
+        }
+        len++;
+    }
+    if (!len)
+      return lString32::empty_str;
+    dst.pchunk->len = len;
+    p[len] = 0;
+    return dst;
+}
 
