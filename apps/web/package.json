{
  "name": "@lexeme/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "`pnpm dev` starts both apps, but Vite is up first, so without this it proxies /api into a server that has not booted. Trailing `;` rather than `&&`: a missing API should still let you work on the UI. The target has to match `server.proxy` in vite.config.ts.",
    "dev": "wait-on -t 30000 http-get://localhost:3001/health; vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "//start": "Production static serving, for hosts that run a process rather than serving files. -s is the SPA fallback: without it a hard refresh on /deck/<id> 404s.",
    "start": "serve -s dist -l ${PORT:-4173}"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@lexeme/contracts": "workspace:*",
    "@lexeme/shared": "workspace:*",
    "@rocicorp/zero": "catalog:",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "^3.14.2",
    "@tanstack/store": "^0.11.1",
    "better-auth": "catalog:",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fsrs-browser": "^6.6.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "serve": "^14.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "catalog:",
    "usehooks-ts": "^3.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "shadcn": "^4.1.2",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wait-on": "^9.1.0"
  }
}
