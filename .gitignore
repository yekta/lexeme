node_modules/
dist/
.turbo/
coverage/
.DS_Store
*.log
*.tsbuildinfo

# Editor swap and backup files. Their own rule, and not merely `.env*`, because
# an editor's swap file for `.env` is named `..env.swp` or `.env.swp` depending
# on the editor — and `.env*` matches the second but not the first, which is how
# one got committed.
*.swp
*.swo
*~
.*.sw[a-p]

# Secrets. .env.example is the checked-in template.
.env*
!.env.example
.env.keys

# Copied out of packages/db by the server build so the bundle can read them at
# runtime; the originals are the ones under version control.
apps/server/drizzle/

.claude
