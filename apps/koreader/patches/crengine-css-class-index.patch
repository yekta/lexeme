+// An element with more classes than this goes through LVStyleSheet::applyUnindexed().
+#define CSS_INDEX_MAX_CLASSES 16
+
+// The selectors of one chain an element can match, as ranges of the index: the chain's
+// selectors that require no class, and those requiring each of the element's classes.
+struct CssIndexCursor {
+    const LVStyleSheet::IndexEntry * cur[CSS_INDEX_MAX_CLASSES + 1];
+    const LVStyleSheet::IndexEntry * end[CSS_INDEX_MAX_CLASSES + 1];
+    int n;
+    // The next selector in chain order, and which range it's in; NULL at the end.
+    const LVStyleSheet::IndexEntry * peek( int & which ) const {
+        const LVStyleSheet::IndexEntry * best = NULL;
+        for ( int i=0; i<n; i++ ) {
+            if ( cur[i] < end[i] && ( !best || cur[i]->pos < best->pos ) ) {
+                best = cur[i];
+                which = i;
+            }
+        }
+        return best;
+    }
+};
+
+static void openCssIndexCursor( CssIndexCursor & c, const LVStyleSheet::IndexEntry * index,
+        const int * ranges, int nranges, int chain, const lUInt32 * classes, int nclasses )
+{
+    c.n = 0;
+    if ( chain < 0 || chain*3 + 2 >= nranges )
+        return;
+    int classless = ranges[chain*3], classed = ranges[chain*3 + 1], end = ranges[chain*3 + 2];
+    if ( classless < classed ) {
+        c.cur[c.n] = index + classless;
+        c.end[c.n] = index + classed;
+        c.n++;
+    }
+    for ( int k=0; k<nclasses; k++ ) {
+        lUInt32 hash = classes[k];
+        int lo = classed, hi = end; // first entry with this hash
+        while ( lo < hi ) {
+            int mid = (lo + hi) / 2;
+            if ( index[mid].hash < hash )
+                lo = mid + 1;
+            else
+                hi = mid;
+        }
+        int stop = lo;
+        while ( stop < end && index[stop].hash == hash )
+            stop++;
+        if ( lo < stop ) {
+            c.cur[c.n] = index + lo;
+            c.end[c.n] = index + stop;
+            c.n++;
+        }
+    }
+}
