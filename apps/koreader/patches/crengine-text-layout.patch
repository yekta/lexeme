+// When lbProcessNextChar() doesn't know the result for state_id and ch: get it from
+// lb_process_next_char(), and keep it
+int TextLangCfg::lbProcessNextCharAndKeep( struct LineBreakContext * lbpCtx, int & state_id, lChar32 ch ) {
+    if ( !_lb_results ) {
+        if ( !lb_init_ctx_set ) {
+            lb_init_break_context(&lb_init_ctx, 0x200D, NULL);
+            lb_init_ctx_set = true;
+        }
+        _lb_results = (LBNextCharResults *)calloc(1, sizeof(LBNextCharResults));
+        if ( !_lb_results )
+            return lb_process_next_char(lbpCtx, (utf32_t)ch);
+        _lb_ascii_results = _lb_results->ascii;
+    }
+    LBNextCharResults * results = _lb_results;
+    lUInt32 key = 0;
+    lUInt32 other_index = 0;
+    if ( state_id >= 0 ) {
+        if ( ch >= LB_ASCII_SIZE && ch <= LB_MAX_OTHER_CHAR ) {
+            key = ((lUInt32)ch << 8) | (lUInt32)(state_id + 1);
+            other_index = ( key * 0x9E3779B1u ) >> (32 - LB_OTHER_RESULTS_BITS);
+            if ( results->others[other_index].key == key ) {
+                lUInt16 next = results->others[other_index].next;
+                state_id = (next & 0xFF) - 1;
+                return (next >> 8) - 1;
+            }
+        }
+        // lbpCtx has not been updated since state_id was set
+        setLBContextState(lbpCtx, results->states[state_id]);
+    }
+    else if ( lbpCtx->lbpLang != _lb_props ) {
+        return lb_process_next_char(lbpCtx, (utf32_t)ch); // (state_id stays -1: lbpCtx holds it)
+    }
+    else {
+        // Get the state number of lbpCtx, if it can have one
+        lUInt32 state;
+        if ( !getLBContextState(lbpCtx, state) )
+            return lb_process_next_char(lbpCtx, (utf32_t)ch);
+        for ( int i=0; i < results->states_count; i++ ) {
+            if ( results->states[i] == state ) {
+                state_id = i;
+                break;
+            }
+        }
+        if ( state_id < 0 ) {
+            if ( results->states_count >= LB_MAX_STATES )
+                return lb_process_next_char(lbpCtx, (utf32_t)ch);
+            state_id = results->states_count++;
+            results->states[state_id] = state;
+        }
+        if ( ch < LB_ASCII_SIZE ) {
+            // We may know it now
+            lUInt16 next = results->ascii[ (state_id << LB_ASCII_BITS) + ch ];
+            if ( next ) {
+                state_id = (next & 0xFF) - 1;
+                return (next >> 8) - 1;
+            }
+        }
+        else if ( ch <= LB_MAX_OTHER_CHAR ) {
+            key = ((lUInt32)ch << 8) | (lUInt32)(state_id + 1);
+            other_index = ( key * 0x9E3779B1u ) >> (32 - LB_OTHER_RESULTS_BITS);
+            if ( results->others[other_index].key == key ) {
+                lUInt16 next = results->others[other_index].next;
+                state_id = (next & 0xFF) - 1;
+                return (next >> 8) - 1;
+            }
+        }
+    }
+    // Here, lbpCtx holds the state numbered state_id
+    int brk = lb_process_next_char(lbpCtx, (utf32_t)ch);
+    lUInt32 new_state;
+    int new_state_id = -1;
+    if ( getLBContextState(lbpCtx, new_state) ) {
+        for ( int i=0; i < results->states_count; i++ ) {
+            if ( results->states[i] == new_state ) {
+                new_state_id = i;
+                break;
+            }
+        }
+        if ( new_state_id < 0 && results->states_count < LB_MAX_STATES ) {
+            new_state_id = results->states_count++;
+            results->states[new_state_id] = new_state;
+        }
+    }
+    if ( new_state_id >= 0 && brk >= -1 && brk < 254 && ch <= LB_MAX_OTHER_CHAR ) {
+        lUInt16 next = (lUInt16)( (new_state_id + 1) | ((brk + 1) << 8) );
+        if ( ch < LB_ASCII_SIZE )
+            results->ascii[ (state_id << LB_ASCII_BITS) + ch ] = next;
+        else {
+            results->others[other_index].key = key;
+            results->others[other_index].next = next;
+        }
+    }
+    state_id = new_state_id; // (-1 if none: lbpCtx then holds the state)
+    return brk;
+}
