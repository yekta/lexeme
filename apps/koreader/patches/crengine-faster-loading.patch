+/// Reads [start, end of stream) of another stream with a single read, and serves reads
+/// in it from memory (others go to that stream): for many small reads of a known region,
+/// as when reading a ZIP archive's central directory, entry by entry. Reads give what the
+/// other stream would give.
+class LVWindowedStream : public LVNamedStream
+{
+    LVStreamRef m_stream;
+    lUInt8 * m_buf;
+    lvpos_t m_start;
+    lvsize_t m_len;
+    lvpos_t m_pos;
+    LVWindowedStream( LVStreamRef stream, lUInt8 * buf, lvpos_t start, lvsize_t len )
+        : m_stream(stream), m_buf(buf), m_start(start), m_len(len), m_pos(start)
+    {
+        SetName( stream->GetName() );
+    }
+public:
+    /// NULL if the region can't be read
+    static LVStreamRef create( LVStreamRef stream, lvpos_t start )
+    {
+        lvsize_t size = stream->GetSize();
+        if ( start >= size || size - start > 0x1000000 )
+            return LVStreamRef();
+        lvsize_t len = size - start;
+        lUInt8 * buf = (lUInt8 *)malloc( len );
+        if ( !buf )
+            return LVStreamRef();
+        lvsize_t bytesRead = 0;
+        if ( stream->Seek( start, LVSEEK_SET, NULL ) != LVERR_OK
+                || stream->Read( buf, len, &bytesRead ) != LVERR_OK || bytesRead != len ) {
+            free( buf );
+            return LVStreamRef();
+        }
+        return LVStreamRef( new LVWindowedStream( stream, buf, start, len ) );
+    }
+    virtual ~LVWindowedStream()
+    {
+        free( m_buf );
+    }
+    virtual lverror_t Seek( lvoffset_t offset, lvseek_origin_t origin, lvpos_t * pNewPos )
+    {
+        lvoffset_t npos;
+        switch ( origin ) {
+        case LVSEEK_SET:
+            npos = offset;
+            break;
+        case LVSEEK_CUR:
+            npos = (lvoffset_t)m_pos + offset;
+            break;
+        case LVSEEK_END:
+            npos = (lvoffset_t)(m_start + m_len) + offset;
+            break;
+        default:
+            return LVERR_FAIL;
+        }
+        if ( npos < 0 )
+            return LVERR_FAIL;
+        // Past the end, the other stream decides, as some streams fail there and others don't.
+        if ( (lvpos_t)npos > m_start + m_len ) {
+            lverror_t res = m_stream->Seek( npos, LVSEEK_SET, NULL );
+            if ( res != LVERR_OK )
+                return res;
+        }
+        m_pos = (lvpos_t)npos;
+        if ( pNewPos )
+            *pNewPos = m_pos;
+        return LVERR_OK;
+    }
+    virtual lverror_t Read( void * buf, lvsize_t count, lvsize_t * nBytesRead )
+    {
+        if ( m_pos >= m_start && m_pos <= m_start + m_len ) {
+            lvsize_t n = m_start + m_len - m_pos;
+            if ( n > count )
+                n = count;
+            memcpy( buf, m_buf + (m_pos - m_start), n );
+            m_pos += n;
+            if ( nBytesRead )
+                *nBytesRead = n;
+            return LVERR_OK;
+        }
+        lvsize_t n = 0;
+        lverror_t res = m_stream->Seek( m_pos, LVSEEK_SET, NULL );
+        if ( res == LVERR_OK )
+            res = m_stream->Read( buf, count, &n );
+        m_pos += n;
+        if ( nBytesRead )
+            *nBytesRead = n;
+        return res;
+    }
+    virtual lverror_t Write( const void *, lvsize_t, lvsize_t * )
+    {
+        return LVERR_NOTIMPL;
+    }
+    virtual lvsize_t GetSize()
+    {
+        return m_start + m_len;
+    }
+    virtual lverror_t GetSize( lvsize_t * pSize )
+    {
+        if ( pSize )
+            *pSize = m_start + m_len;
+        return LVERR_OK;
+    }
+    virtual lverror_t SetSize( lvsize_t )
+    {
+        return LVERR_NOTIMPL;
+    }
+    virtual bool Eof()
+    {
+        return m_pos >= m_start + m_len;
+    }
+};
