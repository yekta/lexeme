+    // Used by Harfbuzz full: gets the glyphs of the text just shaped by pieces (in arrays of this font)
+    void getShapedGlyphs( int & glyph_count, hb_glyph_info_t * & glyph_info, hb_glyph_position_t * & glyph_pos )
+    {
+        const LVShapingPiece * pieces = _shapingPieces.get();
+        int nb_glyphs = _shapingNbGlyphs;
+        const hb_glyph_info_t * batch_info = NULL;
+        const hb_glyph_position_t * batch_pos = NULL;
+        if ( _shapingBatchBuffer ) {
+            batch_info = hb_buffer_get_glyph_infos(_shapingBatchBuffer, NULL);
+            batch_pos = hb_buffer_get_glyph_positions(_shapingBatchBuffer, NULL);
+        }
+        _shaped_infos.reserve(nb_glyphs);
+        _shaped_positions.reserve(nb_glyphs);
+        hb_glyph_info_t * info = _shaped_infos.get();
+        hb_glyph_position_t * pos = _shaped_positions.get();
+        int g = 0;
+        for ( int p=0; p < _shapingNbPieces; p++ ) {
+            if ( pieces[p].entry ) {
+                LVShapingCache::getGlyphs(pieces[p].entry, info + g, pos + g, pieces[p].start);
+                g += pieces[p].entry->glyph_count;
+                continue;
+            }
+            for ( int bg = pieces[p].batch_start; bg < pieces[p].batch_end; bg++, g++ ) {
+                info[g].codepoint = batch_info[bg].codepoint;
+                info[g].mask = 0;
+                info[g].cluster = batch_info[bg].cluster;
+                info[g].var1.u32 = 0;
+                info[g].var2.u32 = 0;
+                pos[g].x_advance = batch_pos[bg].x_advance;
+                pos[g].y_advance = batch_pos[bg].y_advance;
+                pos[g].x_offset = batch_pos[bg].x_offset;
+                pos[g].y_offset = batch_pos[bg].y_offset;
+                pos[g].var.u32 = 0;
+            }
+        }
+        glyph_count = nb_glyphs;
+        glyph_info = info;
+        glyph_pos = pos;
+    }
