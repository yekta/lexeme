+/// whether getText() is only spaces, tabs and newlines, as IsEmptySpace() on it says
+bool ldomNode::isEmptySpaceText() const
+{
+    ASSERT_NODE_NOT_NULL;
+#if BUILD_LITE!=1
+    if ( TNTYPE == NT_PTEXT ) {
+        // getText() decodes the UTF-8 bytes up to the first 0, and single byte
+        // chars decode as themselves: as long as there are only these, they tell.
+        const lChar8 * text;
+        int length;
+        if ( getDocument()->_textStorage.getTextBytes( _data._ptext_addr, text, length ) ) {
+            for ( int i = 0; i < length; i++ ) {
+                lUInt8 b = (lUInt8)text[i];
+                if ( b == ' ' || b == '\r' || b == '\n' || b == '\t' )
+                    continue;
+                if ( b == 0 )
+                    return true; // where decoding stops
+                if ( b < 0x80 )
+                    return false;
+                // A multi-byte char: decoding is needed to tell
+                lString32 s = getText();
+                return IsEmptySpace(s.c_str(), s.length());
+            }
+            return true;
+        }
+    }
+#endif
+    lString32 s = getText();
+    return IsEmptySpace(s.c_str(), s.length());
 }
 
