+    // kind is SHAPING_MEASURES (the cache keeping only that for measuring, which is much
+    // smaller).
+    // Text is only shaped by pieces if all its chars are in this font (and none is a tab),
+    // so that HarfBuzz gets them as they are, with or without a fallback font (filterChar()
+    // would keep them all).
+    // Returns false, having changed nothing but _hb_buffer contents, when the text can't
+    // be shaped by pieces (or, with SHAPING_MEASURES, when some glyph is not found): it
+    // must then be shaped as a whole.
+    bool shapeByPieces( const lChar32 * text, int len, lUInt32 hints, TextLangCfg * lang_cfg,
+                        bool latin_if_no_script, hb_script_t & script, int kind )
+    {
+        if ( _shaping_by_pieces < 0 ) {
+            _shaping_by_pieces = 0;
+            bool features_global = true;
+            for ( int i=0; i < _hb_features.length(); i++ ) {
+                if ( _hb_features[i].start != HB_FEATURE_GLOBAL_START || _hb_features[i].end != HB_FEATURE_GLOBAL_END )
+                    features_global = false;
+            }
+            if ( features_global ) {
+                LVShapingFaceInfo * info = getShapingFaceInfo(_hb_font, _face, _fileName, _hb_features);
+                _shaping_cmap = NULL;
+                if ( info->by_pieces && !info->key.empty() ) {
+                    if ( !info->cmap )
+                        info->cmap = (lUInt16 *)calloc(SHAPING_CMAP_SIZE, sizeof(lUInt16));
+                    _shaping_cmap = info->cmap;
+                }
+                if ( info->by_pieces ) {
+                    if ( !_shaping_chars )
+                        _shaping_chars = (lUInt32 *)malloc(sizeof(info->chars));
+                    if ( _shaping_chars ) {
+                        memcpy(_shaping_chars, info->chars, sizeof(info->chars));
+                        _shaping_by_pieces = 1;
+                    }
+                }
+            }
+        }
+        if ( !_shaping_by_pieces || len <= 0 ) {
+            return false;
+        }
+        // Only left-to-right (with the scripts allowed below, a direction
+        // not given would be guessed left-to-right)
+        if ( (hints & LFNT_HINT_DIRECTION_KNOWN) && (hints & LFNT_HINT_DIRECTION_IS_RTL) ) {
+            return false;
+        }
+        // Only chars in this font (and allowed with it): checked below while cutting the text
+        const lUInt32 * chars = _shaping_chars;
+        // The script hb_buffer_guess_segment_properties() would set: the first one
+        // not Common, Inherited or Unknown (in ASCII, Latin for letters, else Common)
+        script = HB_SCRIPT_INVALID;
+        for ( int i=0; i < len; i++ ) {
+            lChar32 c = text[i];
+            if ( c < 0x80 ) {
+                if ( (lChar32)((c | 0x20) - 'a') < 26 ) {
+                    script = HB_SCRIPT_LATIN;
+                    break;
+                }
+                continue;
+            }
+            hb_script_t s = hb_unicode_script(hb_unicode_funcs_get_default(), c);
+            if ( s != HB_SCRIPT_COMMON && s != HB_SCRIPT_INHERITED && s != HB_SCRIPT_UNKNOWN ) {
+                script = s;
+                break;
+            }
+        }
+        if ( script == HB_SCRIPT_INVALID && latin_if_no_script )
+            script = HB_SCRIPT_LATIN;
