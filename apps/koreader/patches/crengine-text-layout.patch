+// lb_process_next_char() updates a line breaking context with the next char, and returns
+// the break opportunity before that char. It is called for every char laid out, and was a
+// large part of the layout time, while most texts only meet a few dozen different context
+// states, and a few thousand combinations of state and char. Its results only depend on
+// the context fields and the char (and on libunibreak's and our _lb_props tables, which
+// don't change), so they can be kept and reused: TextLangCfg::lbProcessNextChar() does
+// this, as a state machine whose states are the context states met, numbered as met:
+// - the context fields that change from char to char are packed into a 32 bits state,
+//   and we check that the others are as initialized by lb_init_break_context() without
+//   a language name (as crengine does, which also means no LB25 fixups); otherwise the
+//   context is left to lb_process_next_char() alone.
+// - for each state number and ASCII char, the next state number and the break are kept
+//   in a table directly indexed by both, for the most common chars to need only one memory
+//   read (on a slow device, the time taken by the chain of these reads, each needing the
+//   previous one, is what matters most), and by a hash of both for the other chars.
+// This needs to know all the LineBreakContext fields: if libunibreak changes them, the
+// following static_assert should fail, and the code below must be updated.
+struct LineBreakContextFields {
+    const char *lang;
+    const struct LineBreakProperties *lbpLang;
+    enum LineBreakClass lbcCur;
+    enum LineBreakClass lbcNew;
+    enum LineBreakClass lbcLast;
+    size_t posLast;
+#if UB_LANG_FLAGS
+    bool fLangCjk;
+    bool fLangStrict;
+#endif
+    bool fLb8aZwj;
+    bool fLb21aHebrew;
+    int cLb30aRI;
+    enum Lb25State eLb25;
+    size_t posLb25Fixup;
+    bool fLb25Mark;
+};
+static_assert( sizeof(struct LineBreakContext) == sizeof(struct LineBreakContextFields),
+        "LineBreakContext has changed: TextLangCfg::lbProcessNextChar() must be updated" );
 
+#define LB_MAX_STATES 64 // (at most 255)
+#define LB_OTHER_RESULTS_BITS 10
+#define LB_OTHER_RESULTS_SIZE (1 << LB_OTHER_RESULTS_BITS)
+#define LB_MAX_OTHER_CHAR 0xFFFFFF // (so it fits in a key with the state number)
+struct TextLangCfg::LBNextCharResults {
+    lUInt32 states[LB_MAX_STATES]; // packed context state of each state number
+    int states_count;
+    // For each state number and ASCII char: 0 if not known yet, or the next state number + 1
+    // in the low byte and the break + 1 in the high byte.
+    lUInt16 ascii[LB_MAX_STATES << LB_ASCII_BITS];
+    // For other chars, by hash: the char and state number (key, 0 if unused), and the result
+    // as above.
+    struct { lUInt32 key; lUInt16 next; } others[LB_OTHER_RESULTS_SIZE];
+};
+
+// The fields not packed in the state, as set by lb_init_break_context( ctx, ch, NULL ) (whatever ch)
+static struct LineBreakContext lb_init_ctx;
+static bool lb_init_ctx_set = false;
+
+// Packs the state of ctx, returns false if it can't be (other fields are not as expected)
+static bool getLBContextState( const struct LineBreakContext * ctx, lUInt32 & state ) {
+    if ( ctx->lang != lb_init_ctx.lang || ctx->posLast != lb_init_ctx.posLast
+            || ctx->posLb25Fixup != lb_init_ctx.posLb25Fixup || ctx->fLb25Mark != lb_init_ctx.fLb25Mark
+#if UB_LANG_FLAGS
+            || ctx->fLangCjk != lb_init_ctx.fLangCjk || ctx->fLangStrict != lb_init_ctx.fLangStrict
+#endif
+       )
+        return false;
+    lUInt32 lbc = (lUInt32)ctx->lbcCur | (lUInt32)ctx->lbcNew | (lUInt32)ctx->lbcLast;
+    if ( lbc > 63 || (lUInt32)ctx->cLb30aRI > 3 || (lUInt32)ctx->eLb25 > 7 )
+        return false;
+    state = (lUInt32)ctx->lbcCur | ((lUInt32)ctx->lbcNew << 6) | ((lUInt32)ctx->lbcLast << 12)
+              | ((lUInt32)ctx->fLb8aZwj << 18) | ((lUInt32)ctx->fLb21aHebrew << 19)
+              | ((lUInt32)ctx->cLb30aRI << 20) | ((lUInt32)ctx->eLb25 << 22);
+    return true;
+}
+
+// Unpacks state into ctx (whose other fields are as when state was packed)
+static void setLBContextState( struct LineBreakContext * ctx, lUInt32 state ) {
+    ctx->lbcCur = (enum LineBreakClass)(state & 63);
+    ctx->lbcNew = (enum LineBreakClass)((state >> 6) & 63);
+    ctx->lbcLast = (enum LineBreakClass)((state >> 12) & 63);
+    ctx->fLb8aZwj = (state >> 18) & 1;
+    ctx->fLb21aHebrew = (state >> 19) & 1;
+    ctx->cLb30aRI = (state >> 20) & 3;
+    ctx->eLb25 = (enum Lb25State)((state >> 22) & 7);
+}
+
+void TextLangCfg::lbSyncContext( struct LineBreakContext * lbpCtx, int & state_id ) {
+    if ( state_id >= 0 ) {
+        setLBContextState(lbpCtx, _lb_results->states[state_id]);
+        state_id = -1;
+    }
+}
