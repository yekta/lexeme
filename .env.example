# One .env at the repo root, read by both apps.
#
#   apps/server  loads this file directly (src/env.ts) and validates it at boot
#   apps/web     is a static bundle, so only VITE_* reach it, baked in at build
#                time — never put a secret behind a VITE_ prefix
#   zero-cache   reads its own ZERO_* variables (see `pnpm dev:zero-cache`)

# --- server ---------------------------------------------------------------

# Railway sets PORT itself; 3001 locally, which is what the web dev server
# proxies /api to.
PORT=3001

DATABASE_URL=postgresql://user:password@host:5432/lexeme

# Apply pending drizzle migrations on boot. Leave on unless you run them out of
# band, in which case: pnpm db:migrate
MIGRATE_ON_START=true

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Where this API is reachable, and where Google sends the OAuth callback.
# Locally that is the web dev server, which proxies /api through to it.
BETTER_AUTH_URL=http://localhost:3000
# Where the browser app is served from: the CORS allow-list, and the origin
# Better Auth will accept a post-sign-in callbackURL on.
WEB_ORIGIN=http://localhost:3000

# In production, the registrable parent domain the session cookie is issued for,
# e.g. .lexeme.fyi — so the app, this API and zero-cache all see it. Leave unset
# locally, where the dev proxy makes everything one origin. A *.up.railway.app
# host will NOT work here: those are separate sites, not sibling subdomains.
# COOKIE_DOMAIN=.lexeme.fyi

# Google is the only sign-in method.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Card suggestion and back generation.
ANTHROPIC_API_KEY=

# --- web (build-time, public) ---------------------------------------------

# Where the API is. Leave empty in dev: the Vite server proxies /api, which
# keeps the session cookie first-party and needs no CORS or COOKIE_DOMAIN setup.
# VITE_API_URL=https://api.lexeme.fyi

# The zero-cache this build syncs through.
VITE_ZERO_CACHE_URL=http://localhost:4848

# --- zero-cache -----------------------------------------------------------
#
# Read by zero-cache itself, not by our code. `pnpm dev:zero-cache` sources this
# file and defaults ZERO_UPSTREAM_DB to DATABASE_URL.
#
# ZERO_UPSTREAM_DB=
# The publication drizzle/0003 creates. It lists exactly the tables in
# packages/contracts/src/schema.ts, which is what keeps the Better Auth tables
# out of every client's replica.
ZERO_APP_PUBLICATIONS=zero_data
# Where zero-cache calls back into the API to authorize queries and apply
# mutations. Point these at apps/server.
# ZERO_GET_QUERIES_URL=https://api.lexeme.fyi/api/zero/query
# ZERO_PUSH_URL=https://api.lexeme.fyi/api/zero/mutate
# Sync authenticates by forwarding the browser's session cookie to those two
# endpoints, which is what COOKIE_DOMAIN above exists for.
# ZERO_GET_QUERIES_FORWARD_COOKIES=true
# ZERO_PUSH_FORWARD_COOKIES=true
