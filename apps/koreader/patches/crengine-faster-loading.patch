+/// inserts child text, as insertChildText(UnicodeToUtf8(text, len), before_last_child) does,
+/// without making that string
+ldomNode * ldomNode::insertChildText(const lChar32 * text, int len, bool before_last_child)
+{
+    ASSERT_NODE_NOT_NULL;
+#if !defined(USE_PERSISTENT_TEXT) || BUILD_LITE==1
+    return insertChildText(UnicodeToUtf8(text, len), before_last_child);
+#else
+    // (Its UTF-8 length is found while encoding it, if it can't be more than a text
+    // item's length holds: otherwise, it's needed first)
+    int utf8len = -1;
+    if ( len <= 0 ) {
+        utf8len = 0;
+    } else if ( len > 0x3FFF ) {
+        utf8len = utf8EncodedLength(text, len);
+        if ( utf8len > 0xFFFF ) // more than a text item's length holds: as it always was
+            return insertChildText(UnicodeToUtf8(text, len), before_last_child);
+    }
+    if  ( isElement() ) {
+        if ( isPersistent() )
+            modify();
+        tinyElement * me = NPELEM;
+        ldomNode * node = getDocument()->allocTinyNode( NT_PTEXT );
+        node->_data._ptext_addr = getDocument()->_textStorage.allocText( node->_handle._dataIndex, _handle._dataIndex, text, len > 0 ? len : 0, utf8len );
+        int index = me->_children.length();
+        if ( before_last_child && index > 0 )
+            index--;
+        me->_children.insert( index, node->getDataIndex() );
+        return node;
+    }
+    readOnlyError();
+    return NULL;
+#endif
+}
