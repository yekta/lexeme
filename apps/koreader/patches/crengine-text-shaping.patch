+    // Used by Harfbuzz full: sets the widths and flags measureText() gets going along the
+    // glyphs of the text just shaped by pieces with SHAPING_MEASURES, from their per char
+    // measures. Returns false if widths don't stay within 0..max_width (where measureText()
+    // would stop): measureText() must then shape the text as a whole.
+    bool measureShapedPieces( const lChar32 * text, lUInt16 * widths, lUInt8 * flags,
+                              int max_width, int letter_spacing )
+    {
+        const LVShapingPiece * pieces = _shapingPieces.get();
+        int nb_pieces = _shapingNbPieces;
+        const lInt16 * new_measures = _shapingMeasures.get(); // (of the pieces not cached)
+        int max = max_width < 0xFFFF ? max_width : 0xFFFF;
+        int width = 0;
+        for ( int p=0; p < nb_pieces; p++ ) {
+            const lUInt8 * measures8 = NULL;
+            const lInt16 * measures16 = NULL;
+            if ( pieces[p].entry )
+                LVShapingCache::getMeasures(pieces[p].entry, measures8, measures16);
+            else
+                measures16 = new_measures + pieces[p].start;
+            int start = pieces[p].start;
+            int end = pieces[p].end;
+            if ( measures8 ) {
+                // (no negative advance here: no check needed for width < 0)
+                for ( int t = start; t < end; t++ ) {
+                    int m = measures8[t - start];
+                    int advance = m >> 1;
+                    width += advance;
+                    lUInt8 f;
+                    if ( m & 1 ) { // continues a cluster
+                        f = LCHAR_IS_CLUSTER_TAIL;
+                    }
+                    else {
+                        f = GET_CHAR_FLAGS(text[t]);
+                        if ( advance == 0 ) // (e.g. soft hyphen): no letter spacing
+                            f |= LCHAR_IS_CLUSTER_TAIL;
+                        else
+                            width += letter_spacing;
+                    }
+                    if ( width > max )
+                        return false;
+                    flags[t] = f;
+                    widths[t] = (lUInt16)width;
+                }
+                continue;
+            }
+            for ( int t = start; t < end; t++ ) {
+                int m = measures16[t - start];
+                int advance = (m - (m & 1)) / 2;
+                width += advance;
+                lUInt8 f;
+                if ( m & 1 ) { // continues a cluster
+                    f = LCHAR_IS_CLUSTER_TAIL;
+                }
+                else {
+                    f = GET_CHAR_FLAGS(text[t]);
+                    if ( advance == 0 ) // (e.g. soft hyphen): no letter spacing
+                        f |= LCHAR_IS_CLUSTER_TAIL;
+                    else
+                        width += letter_spacing;
+                }
+                if ( width < 0 || width > max )
+                    return false;
+                flags[t] = f;
+                widths[t] = (lUInt16)width;
+            }
+        }
+        return true;
+    }
